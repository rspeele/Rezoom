<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <Authors>Robert Peele</Authors>
    <Company>Robert Peele</Company>
    <Copyright>Copyright Robert Peele 2017</Copyright>
    <Description>A resumption monad for .NET targeting data access with automatic batching and caching.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/rspeele/Rezoom</PackageProjectUrl>
    <PackageTags>rezoom monad resumption data</PackageTags>
    <PackageReleaseNotes>Modernized for the 2026 .NET ecosystem after a long dormancy. Multi-targets netstandard2.0, net8.0, and net10.0. Drops embedded TaskBuilder.fs in favor of FSharp.Core's built-in `task { }` (requires FSharp.Core 8.0.401+). Replaces the custom IServiceConfig with the standard IServiceProvider. Adds PlanExecutor for DI-friendly plan execution. ServiceContext renamed to PlanContext. Breaking changes for code that used the old service-config API.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>2.0.0</Version>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="ExceptionTypes.fs" />
    <Compile Include="InternalUtilities.fs" />
    <Compile Include="PlanLocal.fs" />
    <Compile Include="CacheInfo.fs" />
    <Compile Include="Errand.fs" />
    <Compile Include="Shims.fs" />
    <Compile Include="Plan.fs" />
    <Compile Include="PlanModule.fs" />
    <Compile Include="PlanBuilder.fs" />
    <Compile Include="Caching.fs" />
    <Compile Include="Execution.fs" />
    <Compile Include="PlanExecutor.fs" />
    <Compile Include="Replay.fs" />
    <Compile Include="Stdlib.fs" />
    <Compile Include="CS.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="8.0.401" />
  </ItemGroup>

</Project>
